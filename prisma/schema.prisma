// Database schema for the email tool.
// After changing this file, run:  npx prisma migrate dev --name <what-you-changed>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Authentication (tables required by Better Auth)
// ─────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  /// Two-factor login (Better Auth "twoFactor" plugin).
  twoFactorEnabled Boolean? @default(false)

  sessions    Session[]
  accounts    Account[]
  memberships WorkspaceMember[]
  twoFactors  TwoFactor[]

  @@map("user")
}

/// The authenticator-app secret and backup codes of a user with 2FA turned on
/// (managed entirely by Better Auth's twoFactor plugin; both are encrypted).
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────
// Workspaces: every contact, campaign and template will belong to one.
// This is what keeps one customer's data separate from another's.
// ─────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Phase 6 — double opt-in: new subscribers from forms/API must click a
  /// confirmation link before they can receive campaigns.
  doubleOptIn   Boolean @default(false)
  /// The verified sender the confirmation email comes from (null = none set).
  optInSenderId String?
  /// Customisable confirmation email (null = our default wording).
  optInSubject  String?
  optInMessage  String?

  /// General settings: how dates and times are shown, and the day boundaries
  /// used by statistics. IANA time zone name, e.g. "Asia/Kolkata".
  timezone   String @default("UTC")
  /// "DMY" (13-11-2026), "MDY" (11-13-2026) or "YMD" (2026-11-13).
  dateFormat String @default("DMY")
  /// "24h" or "12h".
  timeFormat String @default("24h")

  /// UTM tags added to links in campaign and automation emails (at launch),
  /// so the customer's own analytics can see which email sent a visitor.
  /// utm_campaign is the campaign's name (slugified).
  utmEnabled Boolean @default(false)
  utmSource  String  @default("klyve")
  utmMedium  String  @default("email")

  members WorkspaceMember[]
  invites WorkspaceInvite[]
  campaignFolders CampaignFolder[]
  aiUsage AiUsage[]

  contacts      Contact[]
  suppressions  Suppression[]
  consentEvents ConsentEvent[]
  lists         ContactList[]
  attributes    ContactAttribute[]
  segments      Segment[]
  imports       ContactImport[]

  sendingProviders SendingProvider[]
  senders          Sender[]
  sendingDomains   SendingDomain[]

  templates   EmailTemplate[]
  brandKit    BrandKit?
  mediaAssets MediaAsset[]

  campaigns Campaign[]

  signupForms SignupForm[]
  automations Automation[]
  apiKeys     ApiKey[]
  transactionalEmails TransactionalEmail[]

  @@map("workspace")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_member")
}

/// An emailed invitation to join a workspace. The link holds a random token;
/// only its sha256 hash is stored. Accepting needs a logged-in user whose
/// email matches `email`.
model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Lower-cased.
  email       String
  /// Never OWNER: ownership is not handed out by invite.
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([workspaceId, createdAt])
  @@index([email])
  @@map("workspace_invite")
}

/// One AI request (Groq), counted against the workspace's monthly AI limit
/// and the user's daily limit. Rows are written only for requests that were
/// actually sent to the AI provider.
model AiUsage {
  id               String    @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId           String?
  /// e.g. "generate_campaign", "subject_ideas", "improve_text", "segment", "automation", "explain_report".
  feature          String
  model            String
  promptTokens     Int       @default(0)
  completionTokens Int       @default(0)
  /// false when the provider answered with an error (still counts: it cost a request).
  ok               Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

// ─────────────────────────────────────────────
// Phase 1: Contacts
// EVERY model below has a workspaceId. Every query MUST filter by the
// active workspace's id — that is what keeps customers' data apart.
// ─────────────────────────────────────────────

/// Whether we're allowed to email this contact.
enum ContactStatus {
  SUBSCRIBED // can receive campaigns
  UNSUBSCRIBED // clicked unsubscribe or was unsubscribed by the workspace
  BOUNCED // the address doesn't exist / keeps failing (set in Phase 5)
  COMPLAINED // marked one of our emails as spam (set in Phase 5)
  PENDING // double opt-in: confirmation email sent, link not clicked yet (Phase 6)
}

model Contact {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Always stored lower-cased and trimmed (see normalizeEmail()).
  email       String
  firstName   String?
  lastName    String?
  status      ContactStatus @default(SUBSCRIBED)
  /// Values for the workspace's custom attributes, keyed by ContactAttribute.key,
  /// e.g. { "CITY": "Pune", "AGE": 31, "VIP": true, "BIRTHDAY": "1994-05-12" }.
  attributes  Json          @default("{}")
  /// Where the contact came from: "manual", "import", "form", "api".
  source      String        @default("manual")
  /// Double opt-in: when the confirmation email was last sent / when they confirmed.
  optInSentAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lists              ListMembership[]
  campaignRecipients CampaignRecipient[]
  consentEvents      ConsentEvent[]
  automationRuns     AutomationRun[]

  transactionalEmails TransactionalEmail[]
  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, confirmedAt]) // automation triggers: "confirmed since…"
  @@map("contact")
}

model ContactList {
  id                String    @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  /// Phase 6 — shown in the subscriber preference centre, where people can
  /// choose which public lists to stay on. Private lists are never shown.
  isPublic          Boolean   @default(false)
  publicName        String?
  publicDescription String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members ListMembership[]
  imports ContactImport[]

  @@unique([workspaceId, name])
  @@map("contact_list")
}

/// Which contacts are in which lists (a contact can be in many lists).
model ListMembership {
  listId    String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now())

  @@id([listId, contactId])
  @@index([contactId])
  @@index([listId, addedAt]) // automation "joined list" trigger scans
  @@map("list_membership")
}

enum AttributeType {
  TEXT
  NUMBER
  DATE // stored as "YYYY-MM-DD" text in Contact.attributes
  BOOLEAN
}

/// A custom field the workspace defined, e.g. CITY (text) or AGE (number).
model ContactAttribute {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// UPPER_SNAKE_CASE, used in templates as {{ contact.CITY }}. Never changes.
  key         String
  /// Human-friendly name shown in the UI, e.g. "City".
  label       String
  type        AttributeType @default(TEXT)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, key])
  @@map("contact_attribute")
}

/// A saved filter, e.g. "subscribed contacts in Pune who are VIP".
/// Evaluated live every time, so it is always up to date.
model Segment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// The filter rules (shape defined in src/lib/segments/rules.ts).
  rules       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, name])
  @@map("segment")
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// History of CSV imports, with a summary of what happened.
model ContactImport {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileName    String
  status      ImportStatus @default(PROCESSING)
  /// Optional list every imported contact was added to.
  listId      String?
  list        ContactList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  totalRows   Int          @default(0)
  created     Int          @default(0)
  updated     Int          @default(0)
  skipped     Int          @default(0)
  /// Up to ~100 problems, e.g. [{ "row": 12, "reason": "Invalid email" }].
  errors      Json         @default("[]")
  createdAt   DateTime     @default(now())
  finishedAt  DateTime?

  @@index([workspaceId, createdAt])
  @@map("contact_import")
}

// ─────────────────────────────────────────────
// Phase 2: Sending
// Users connect THEIR OWN email service. We store their credentials
// encrypted (AES-256-GCM, see src/lib/crypto.ts) and never send them
// back to the browser.
// ─────────────────────────────────────────────

enum ProviderType {
  SMTP // any SMTP server: Gmail, Outlook, Zoho, Brevo SMTP, your own...
  AMAZON_SES
  RESEND
  SENDGRID
  MAILGUN
  POSTMARK
}

enum ProviderStatus {
  UNTESTED // saved, connection not checked yet
  CONNECTED // last check succeeded
  FAILED // last check or send failed (see lastError)
}

model SendingProvider {
  id              String         @id @default(cuid())
  workspaceId     String
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The user's own label, e.g. "Company SES" or "My Gmail".
  name            String
  type            ProviderType
  /// Encrypted JSON blob of the credentials (shape per type: src/lib/email/provider-configs.ts).
  credentials     String
  /// Safe-to-show summary, e.g. { "host": "smtp.gmail.com", "user": "me@gmail.com", "key": "••••a1b2" }.
  credentialsHint Json           @default("{}")
  status          ProviderStatus @default(UNTESTED)
  lastTestedAt    DateTime?
  lastError       String?
  /// The provider used when a campaign doesn't pick one. One per workspace.
  isDefault       Boolean        @default(false)
  /// Sending speed limit, so we never exceed the provider's rate (emails/second).
  maxPerSecond    Int            @default(5)
  /// Optional daily cap set by the user (null = no cap from our side).
  dailyLimit      Int?
  /// Secret part of this provider's webhook URL (/api/webhooks/<id>/<token>),
  /// where it reports bounces and spam complaints. Random, generated on demand.
  webhookToken    String?        @unique
  /// Optional signing secret the provider gives you, used to verify webhooks
  /// (encrypted, like `credentials`). Shape depends on the provider.
  webhookSecret   String?
  /// When we last received a webhook from this provider (shows setup worked).
  lastWebhookAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  senders    Sender[]
  campaigns  Campaign[]
  dailyUsage ProviderDailyUsage[]

  transactionalEmails TransactionalEmail[]
  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("sending_provider")
}

/// A "From" address the workspace may send campaigns from.
/// The user proves they own it by entering a code we email to it.
model Sender {
  id                    String           @id @default(cuid())
  workspaceId           String
  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Lower-cased, e.g. "news@acme.com".
  email                 String
  /// Display name, e.g. "Acme News".
  name                  String
  replyTo               String?
  /// Provider used to send the verification code (and the sender's default provider).
  providerId            String?
  provider              SendingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  verifiedAt            DateTime?
  /// SHA-256 hash of the 6-digit code; the plain code is never stored.
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationAttempts  Int              @default(0)
  verificationSentAt    DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  campaigns Campaign[]

  transactionalEmails TransactionalEmail[]
  @@unique([workspaceId, email])
  @@map("sender")
}

/// A domain whose DNS records (SPF / DKIM / DMARC) we check and explain.
model SendingDomain {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Lower-cased, e.g. "acme.com".
  domain        String
  /// DKIM selectors to look up, e.g. ["resend", "s1"]; filled from the provider or by the user.
  dkimSelectors String[]  @default([])
  /// Last check results (shape: src/lib/email/dns-check.ts).
  lastResult    Json?
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  @@unique([workspaceId, domain])
  @@map("sending_domain")
}

// ─────────────────────────────────────────────
// Phase 3: Templates & editor
// ─────────────────────────────────────────────

/// A reusable email design. `document` is the editor's JSON (src/lib/templates/document.ts);
/// `html`/`text` are the rendered output, refreshed on every save.
model EmailTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// Default subject + preview text for campaigns using this template.
  subject     String    @default("")
  preheader   String    @default("")
  /// Which starter template it was created from (e.g. "welcome"), if any.
  starterId   String?
  document    Json
  /// Rendered email HTML with {{ merge tags }} still in place (filled per contact at send time).
  html        String    @default("")
  text        String    @default("")
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  transactionalEmails TransactionalEmail[]
  @@index([workspaceId, updatedAt])
  @@map("email_template")
}

/// The workspace's look: applied to new templates and starter templates.
model BrandKit {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyName     String    @default("")
  /// Public URL of the logo (usually a MediaAsset URL).
  logoUrl         String?
  primaryColor    String    @default("#059669")
  secondaryColor  String    @default("#0f172a")
  backgroundColor String    @default("#f4f4f5")
  textColor       String    @default("#27272a")
  fontFamily      String    @default("Arial, Helvetica, sans-serif")
  /// Postal address: anti-spam laws (CAN-SPAM, etc.) require it in marketing email footers.
  address         String    @default("")
  websiteUrl      String?
  /// e.g. { "instagram": "https://instagram.com/acme", "x": "..." }
  socialLinks     Json      @default("{}")
  updatedAt       DateTime  @updatedAt

  @@map("brand_kit")
}

/// An uploaded image (logo, email picture). Served publicly at /media/<id>
/// because email clients must be able to load it without logging in.
model MediaAsset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileName    String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  /// Where the bytes live, e.g. "local:<workspaceId>/<id>.png" (S3/R2 later).
  storageKey  String    @unique
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@map("media_asset")
}

// ─────────────────────────────────────────────
// Phase 4: Campaigns
// A campaign is one email sent to an audience (lists/segments).
// When it launches we "freeze" the audience into CampaignRecipient rows,
// one per contact, and a background worker sends them one by one.
// That table is also what guarantees nobody gets the same campaign twice.
// ─────────────────────────────────────────────

enum CampaignStatus {
  DRAFT // being written
  SCHEDULED // will start at scheduledAt
  SENDING // the worker is sending it
  PAUSED // stopped by the user (or by us after a provider failure); can resume
  SENT // every recipient was processed
  CANCELLED // stopped for good by the user
  FAILED // could not start or run (see lastError)
}

enum CampaignKind {
  REGULAR // a normal one-off campaign (Campaigns page)
  AUTOMATION // the email of one "send email" step in an automation (hidden from the Campaigns page)
}

model Campaign {
  id               String         @id @default(cuid())
  workspaceId      String
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  status           CampaignStatus @default(DRAFT)
  /// Phase 8: automation emails reuse the whole campaign sending engine
  /// (tracking, unsubscribe, suppression, rate limits). Such a campaign stays
  /// SENDING while its automation is active; recipients are added one by one
  /// as people reach the step, and it never "finishes".
  kind             CampaignKind   @default(REGULAR)
  automationId     String?
  automation       Automation?    @relation(fields: [automationId], references: [id], onDelete: Cascade)
  /// The step's id inside Automation.steps.
  automationStepId String?

  /// Optional folder on the Campaigns page (regular campaigns only).
  folderId String?
  folder   CampaignFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  subject   String @default("")
  preheader String @default("")

  /// Who it comes from. Must be a VERIFIED sender of the workspace to launch.
  senderId   String?
  sender     Sender?          @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// The provider used, fixed at launch (sender's provider, else the workspace default).
  providerId String?
  provider   SendingProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  /// Who gets it. Shape: src/lib/campaigns/audience.ts (lists, segments, exclusions).
  audience Json @default("{}")

  /// The campaign's OWN copy of the design, so editing a template later never
  /// changes a campaign (and vice versa). Shape: src/lib/templates/document.ts
  document   Json?
  /// Template it was started from (for reference only).
  templateId String?
  /// Rendered at launch (merge tags still in place; filled per recipient).
  html       String  @default("")
  text       String  @default("")

  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?

  /// Counters, updated by the worker (also derivable from CampaignRecipient).
  recipientCount Int @default(0)
  sentCount      Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)

  /// Phase 5 tracking switches (copied onto each send).
  trackOpens       Boolean @default(true)
  trackClicks      Boolean @default(true)
  /// Unique-person engagement counters (each person counted once).
  openCount        Int     @default(0)
  clickCount       Int     @default(0)
  bounceCount      Int     @default(0)
  complaintCount   Int     @default(0)
  unsubscribeCount Int     @default(0)

  /// Why it was paused or failed, in plain English.
  lastError   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients CampaignRecipient[]
  links      CampaignLink[]
  events     EmailEvent[]

  @@unique([automationId, automationStepId])
  @@index([workspaceId, createdAt])
  @@index([status, scheduledAt])
  @@index([folderId])
  @@map("campaign")
}

/// A folder to organise campaigns on the Campaigns page. Deleting a folder
/// keeps its campaigns (they move back to "No folder").
model CampaignFolder {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime   @default(now())
  campaigns   Campaign[]

  @@unique([workspaceId, name])
  @@map("campaign_folder")
}

enum RecipientStatus {
  PENDING // waiting to be sent
  SENDING // claimed by the worker right now
  SENT // the provider accepted it
  FAILED // gave up (see lastError)
  SKIPPED // not sent on purpose, e.g. unsubscribed after the campaign started
}

/// One row per (campaign, contact). The unique constraint is the
/// "never send the same campaign twice to the same person" guarantee.
model CampaignRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Copied at launch, so we know who it went to even if the contact is deleted later.
  email             String
  status            RecipientStatus @default(PENDING)
  attempts          Int             @default(0)
  /// When a retry is allowed (after a temporary failure).
  nextAttemptAt     DateTime        @default(now())
  /// When the worker claimed it (to detect a crash mid-send).
  lockedAt          DateTime?
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  /// Set when this person unsubscribed using this email's link.
  unsubscribedAt    DateTime?
  /// Phase 5 engagement (first time + totals). Opens by likely bots
  /// (e.g. Apple Mail privacy prefetch) are counted separately.
  firstOpenedAt     DateTime?
  openCount         Int             @default(0)
  firstClickedAt    DateTime?
  clickCount        Int             @default(0)
  /// The provider reported a delivery to the inbox server (webhooks only).
  deliveredAt       DateTime?
  bouncedAt         DateTime?
  /// "hard" (address doesn't exist) or "soft" (temporary, e.g. mailbox full).
  bounceType        String?
  complainedAt      DateTime?
  createdAt         DateTime        @default(now())

  events EmailEvent[]

  @@unique([campaignId, contactId])
  @@index([providerMessageId])
  /// For a contact's activity timeline and "opened any campaign" segments.
  @@index([contactId])
  @@index([campaignId, status])
  @@index([status, nextAttemptAt])
  @@map("campaign_recipient")
}

/// How many emails a provider sent on a given UTC day, to respect `dailyLimit`.
model ProviderDailyUsage {
  providerId String
  provider   SendingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  /// UTC date, e.g. 2026-11-13.
  day        DateTime        @db.Date
  sent       Int             @default(0)

  @@id([providerId, day])
  @@map("provider_daily_usage")
}

// ─────────────────────────────────────────────
// Phase 5: Tracking & reports
// ─────────────────────────────────────────────

/// A link in a sent campaign. Links are rewritten to /t/c/<token>/<position>
/// so a click can be counted before redirecting to `url`.
model CampaignLink {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  /// 0, 1, 2… in the order the links appear in the email.
  position     Int
  /// The real destination, exactly as written in the email. It may contain
  /// merge tags (e.g. ?e={{ contact.EMAIL }}): they are filled in for the
  /// clicking recipient at click time, then checked to be http(s).
  url          String
  /// Total and unique-person clicks, for the "top links" report.
  clickCount   Int      @default(0)
  uniqueClicks Int      @default(0)
  createdAt    DateTime @default(now())

  events EmailEvent[]

  @@unique([campaignId, position])
  @@map("campaign_link")
}

enum EmailEventType {
  DELIVERED // provider says the inbox server accepted it (webhook)
  OPENED // tracking pixel loaded
  CLICKED // tracked link clicked
  BOUNCED // provider says it bounced (webhook)
  COMPLAINED // recipient marked it as spam (webhook)
  UNSUBSCRIBED // used the unsubscribe link / one-click
}

/// One thing that happened to one sent email. Append-only; the counters on
/// CampaignRecipient / Campaign / CampaignLink are kept in step for fast reports.
model EmailEvent {
  id          String            @id @default(cuid())
  workspaceId String
  campaignId  String
  campaign    Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        EmailEventType
  linkId      String?
  link        CampaignLink?     @relation(fields: [linkId], references: [id], onDelete: SetNull)
  /// true when it looks automated (security scanners, Apple privacy prefetch…).
  isBot       Boolean           @default(false)
  /// Short browser/app description, for the report (never the full string).
  userAgent   String?
  /// SHA-256 of the IP + a server secret: lets us spot duplicates without storing IPs.
  ipHash      String?
  /// Extra detail, e.g. { "bounceType": "hard", "diagnostic": "550 user unknown" }.
  detail      Json?
  createdAt   DateTime          @default(now())

  @@index([campaignId, type, createdAt])
  @@index([recipientId, type])
  @@index([workspaceId, createdAt])
  @@map("email_event")
}

// ─────────────────────────────────────────────
// Phase 6: Compliance & deliverability
// ─────────────────────────────────────────────

enum SuppressionReason {
  MANUAL // added by the workspace (e.g. a bounce notice from Gmail)
  HARD_BOUNCE // the address doesn't exist (from a provider webhook)
  COMPLAINT // marked an email as spam
  UNSUBSCRIBE // asked never to be emailed again
  IMPORT // imported from another tool's suppression/unsubscribe list
  ERASURE // GDPR "forget me": only a hash of the address is kept
}

/// Addresses that must NEVER be emailed by this workspace, whether or not
/// they are (still) a contact. Checked when building a campaign's audience,
/// right before each send, and when importing contacts.
model Suppression {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Lower-cased address. For ERASURE rows this is "sha256:<hex>" instead,
  /// so the person can't be re-added without us storing their address.
  email       String
  reason      SuppressionReason
  note        String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId, createdAt])
  @@map("suppression")
}

enum ConsentEventType {
  SUBSCRIBED // added with permission (manual, import with consent, form)
  CONFIRMATION_SENT // double opt-in email sent
  CONFIRMED // clicked the double opt-in link
  UNSUBSCRIBED
  RESUBSCRIBED
  PREFERENCES_UPDATED // changed list choices in the preference centre
  STATUS_CHANGED // changed by the workspace (e.g. marked subscribed manually)
  ERASED // GDPR erasure (contact deleted; this row keeps only a hash)
}

/// Proof of consent: who agreed to what, when and how. Kept even if the
/// contact is deleted (contactId becomes null), as anti-spam laws expect.
model ConsentEvent {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Address at the time (or "sha256:<hex>" after an erasure).
  email       String
  type        ConsentEventType
  /// Where it happened: "manual", "import", "form", "api", "unsubscribe_link",
  /// "one_click", "preference_centre", "confirmation_link", "webhook", "erasure".
  source      String
  ipHash      String?
  userAgent   String?
  /// Extra facts, e.g. { "importId": "...", "lists": ["..."] }.
  detail      Json?
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([workspaceId, createdAt])
  @@index([contactId, createdAt])
  @@map("consent_event")
}

// ─────────────────────────────────────────────
// Phase 7: Sign-up forms
// ─────────────────────────────────────────────

enum FormStatus {
  ACTIVE // accepting sign-ups
  PAUSED // the public page says "not accepting sign-ups right now"
}

/// A sign-up form people fill in on a hosted page (/f/<publicId>) or on the
/// user's own website (embedded). Submissions create/update contacts through
/// the double opt-in logic (src/lib/optin addPendingContact).
model SignupForm {
  id              String     @id @default(cuid())
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Internal name, e.g. "Website footer".
  name            String
  /// Random public id used in URLs, so form URLs don't reveal the internal id.
  publicId        String     @unique
  status          FormStatus @default(ACTIVE)
  /// Fields, texts and look. Shape: src/lib/forms/schema.ts (formConfigSchema).
  config          Json
  /// Lists every new subscriber is added to.
  listIds         String[]   @default([])
  /// Counters for the forms list (also derivable from FormSubmission).
  submissionCount Int        @default(0)
  createdById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  submissions FormSubmission[]

  @@index([workspaceId, createdAt])
  @@map("signup_form")
}

enum FormSubmissionResult {
  SUBSCRIBED // new or existing contact, now subscribed
  PENDING // double opt-in email sent, waiting for the click
  ALREADY_SUBSCRIBED // was already on the list; nothing to do
  NOT_RESUBSCRIBED // had unsubscribed/bounced/complained: we respect that
  SUPPRESSED // on the suppression list
  SPAM // caught by the honeypot / timing / rate limit checks
}

/// One submission of a form (for the form's stats and as consent evidence).
model FormSubmission {
  id        String               @id @default(cuid())
  formId    String
  form      SignupForm           @relation(fields: [formId], references: [id], onDelete: Cascade)
  contactId String?
  /// Lower-cased address as submitted (null for spam that had no valid email).
  email     String?
  result    FormSubmissionResult
  ipHash    String?
  userAgent String?
  /// The page the form was on (embed Referer/Origin), for "where do sign-ups come from".
  sourceUrl String?
  createdAt DateTime             @default(now())

  @@index([formId, createdAt])
  @@map("form_submission")
}

// ─────────────────────────────────────────────
// Phase 8: Automation
// ─────────────────────────────────────────────

enum AutomationStatus {
  DRAFT // being built; nobody enters
  ACTIVE // new people enter when the trigger happens; runs advance
  PAUSED // nobody new enters; people already inside wait where they are
}

/// A workflow: one trigger, then steps (send email / wait / if-else / …).
/// Shape of `trigger` and `steps`: src/lib/automations/schema.ts.
model Automation {
  id             String           @id @default(cuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  status         AutomationStatus @default(DRAFT)
  trigger        Json
  steps          Json
  /// Can the same person go through it again (e.g. yearly birthday)? The
  /// birthday trigger always allows one run per year.
  allowReentry   Boolean          @default(false)
  /// Trigger scanning progress: events after this time haven't been looked at yet.
  /// Set to the activation time, so turning an automation on never enrols
  /// everyone who joined a list in the past.
  triggerCursor  DateTime?
  activatedAt    DateTime?
  /// Which ready-made recipe it was created from (e.g. "welcome-series"), if any.
  recipeId       String?
  /// Counters for the list page.
  enrolledCount  Int              @default(0)
  completedCount Int              @default(0)
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  runs      AutomationRun[]
  campaigns Campaign[]

  @@index([workspaceId, createdAt])
  @@index([status])
  @@map("automation")
}

enum AutomationRunStatus {
  ACTIVE // ready to run its next step now
  WAITING // in a "wait" step until nextRunAt
  COMPLETED // reached the end
  EXITED // left early (exit step, unsubscribed, contact deleted, automation edited away)
  FAILED // a step couldn't run (see lastError)
}

/// One person going through one automation.
model AutomationRun {
  id            String              @id @default(cuid())
  automationId  String
  automation    Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  status        AutomationRunStatus @default(ACTIVE)
  /// The step to run next (an id inside Automation.steps). null = finished.
  currentStepId String?
  /// When this run should be looked at again (now for ACTIVE, the end of the wait for WAITING).
  nextRunAt     DateTime            @default(now())
  /// When the worker claimed it (crash detection, like campaign recipients).
  lockedAt      DateTime?
  /// For yearly triggers: which occurrence this run is for (e.g. "2026").
  occurrence    String?
  lastError     String?
  startedAt     DateTime            @default(now())
  finishedAt    DateTime?

  logs AutomationLog[]

  @@unique([automationId, contactId, occurrence])
  @@index([status, nextRunAt])
  @@index([automationId, status])
  @@index([contactId])
  @@map("automation_run")
}

/// What happened at each step of a run (the run's history).
model AutomationLog {
  id        String        @id @default(cuid())
  runId     String
  run       AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId    String
  /// "entered", "email_queued", "waited", "branch_yes", "branch_no", "list_added", "exited", "error"…
  action    String
  detail    Json?
  createdAt DateTime      @default(now())

  @@index([runId, createdAt])
  @@map("automation_log")
}

// ─────────────────────────────────────────────
// Phase 9: Transactional API
// ─────────────────────────────────────────────

/// A secret key a workspace's own app uses to call the Klyve API.
/// Only a SHA-256 hash is stored: the key itself is shown once, when created.
model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  /// The first characters (e.g. "klv_3fA9x2"), shown so people can tell keys apart.
  prefix      String
  /// SHA-256 (hex) of the full key.
  keyHash     String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  emails TransactionalEmail[]

  @@index([workspaceId, createdAt])
  @@map("api_key")
}

enum TransactionalStatus {
  QUEUED // accepted, waiting for the worker
  SENDING // handed to the provider right now
  SENT // the provider accepted it
  FAILED // gave up after retries (or a permanent error)
  SUPPRESSED // not sent: the address hard-bounced, complained, or was erased
  BOUNCED // sent, then the provider reported a bounce
  COMPLAINED // sent, then the person marked it as spam
}

/// One email sent through the API (a receipt, a password reset, ...), and its log.
model TransactionalEmail {
  id                String              @id @default(cuid())
  workspaceId       String
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKeyId          String?
  apiKey            ApiKey?             @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  /// "api" or "dashboard" (a test sent from the logs page).
  source            String              @default("api")
  /// From the Idempotency-Key header: the same key twice = the same email, sent once.
  idempotencyKey    String?
  toEmail           String
  toName            String?
  contactId         String?
  contact           Contact?            @relation(fields: [contactId], references: [id], onDelete: SetNull)
  senderId          String?
  sender            Sender?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  providerId        String?
  provider          SendingProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  templateId        String?
  template          EmailTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  fromEmail         String
  fromName          String
  replyTo           String?
  subject           String
  /// Final, personalised content. Cleared after 30 days (privacy + disk space).
  html              String
  text              String
  tags              String[]
  metadata          Json?
  status            TransactionalStatus @default(QUEUED)
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime            @default(now())
  lockedAt          DateTime?
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([workspaceId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([providerMessageId])
  @@index([contactId])
  @@index([createdAt]) // hourly retention clean-up
  @@map("transactional_email")
}
