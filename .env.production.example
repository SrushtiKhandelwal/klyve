# Production settings for docker-compose.prod.yml.
# On the server:  cp .env.production.example .env.production   then fill it in.
# NEVER commit .env.production (it is ignored by git).

# ── Your domain ─────────────────────────────────────────────────────────────
# The address people open, WITHOUT https://. Its DNS "A" record must point at the server.
KLYVE_DOMAIN="app.klyveapp.tech"
# The same address WITH https:// (used in emails: unsubscribe links, images, …).
APP_URL="https://app.klyveapp.tech"
BETTER_AUTH_URL="https://app.klyveapp.tech"

# ── Secrets (generate each one fresh; never reuse the development values) ───
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# 32 random bytes, base64 — encrypts your users' provider passwords/API keys.
# KEEP A SAFE COPY: if it's lost, every connected provider must be re-entered.
ENCRYPTION_KEY=""

# ── Database (used by the "db" service; the app's DATABASE_URL is built from these) ─
POSTGRES_USER="klyve"
POSTGRES_PASSWORD=""
POSTGRES_DB="klyve"

# ── Klyve's own emails (password reset, email verification, double opt-in) ─
# Any SMTP account works. With Amazon SES (docs/DEPLOY.md step 4): smtps://SMTP_USERNAME:SMTP_PASSWORD@email-smtp.ap-south-1.amazonaws.com:465
SYSTEM_SMTP_URL=""
SYSTEM_EMAIL_FROM="Klyve <no-reply@klyveapp.tech>"

# ── Optional ─────────────────────────────────────────────────────────────────
# "false" on extra web servers if you ever run more than one (see src/instrumentation.ts).
# RUN_CAMPAIGN_WORKER="true"
# Allow SMTP servers on private networks (only for self-hosted setups).
# ALLOW_PRIVATE_SMTP_HOSTS="false"
