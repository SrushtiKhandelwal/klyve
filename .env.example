# Copy this file to .env and fill in the values.
DATABASE_URL="postgresql://emailtool:emailtool_dev_password@localhost:5433/emailtool?schema=public"
# Generate with: npx @better-auth/cli secret   (or any random 32+ character string)
BETTER_AUTH_SECRET="change-me"
BETTER_AUTH_URL="http://localhost:3000"

# Local-only test account used for manual testing (localhost database only):
# TEST_USER_EMAIL=tester@mailflow.test
# TEST_USER_PASSWORD=LocalTest-Phase0-2026
# TEST_USER2_EMAIL=tester2@mailflow.test
# TEST_USER2_PASSWORD=LocalTest-Phase0-2026

# 32-byte random key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me"
# Optional SMTP for Klyve's own emails (password reset etc.). Empty = print to terminal.
SYSTEM_SMTP_URL=""
SYSTEM_EMAIL_FROM="Klyve <no-reply@localhost>"
# Or, instead of SYSTEM_SMTP_URL, give the parts separately (no URL-encoding needed):
# SYSTEM_SMTP_HOST="email-smtp.ap-south-1.amazonaws.com"
# SYSTEM_SMTP_PORT="465"
# SYSTEM_SMTP_USER=""
# SYSTEM_SMTP_PASS=""
# Production only: set to true to allow SMTP hosts on private networks (self-hosted setups).
# ALLOW_PRIVATE_SMTP_HOSTS="true"

# AI writing help (Groq). Get a key at https://console.groq.com/keys . Empty = AI buttons show "not set up".
GROQ_API_KEY=""
# Optional: model and address (the address can point at a local stub for testing).
# GROQ_MODEL="openai/gpt-oss-120b"
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# AI limits: requests per workspace per calendar month, and per user per day.
# AI_MONTHLY_LIMIT_PER_WORKSPACE="100"
# AI_DAILY_LIMIT_PER_USER="30"

# Contact address shown on the public site ("Questions? Email us"). Leave empty to hide it.
# CONTACT_EMAIL="hello@yourdomain.com"

# ── "Continue with Google" (optional) ───────────────────────────────────────
# From Google Cloud → Google Auth Platform → Clients (a "Web application" client).
# Its "Authorized redirect URIs" must include <BETTER_AUTH_URL>/api/auth/callback/google.
# Leave empty to hide the Google button. After changing, rebuild (update.sh).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
